# Lexware Office API key (required)
# Get from: https://app.lexoffice.de → Settings → API
LEXOFFICE_API_KEY=your-api-key-here

# Transport (default: streamable-http; also: stdio)
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Bearer token clients must send (Authorization: Bearer <key>). Required for
# HTTP transport: the server refuses to start without it. This is the only
# auth path; there is no Keycloak/OAuth.
MCP_API_KEY=

# Optional: force the tax regime (vatfree | net | gross) instead of auto-detect
# LEXOFFICE_TAX_TYPE=

# Optional: service catalog served at lexoffice://service-catalog, as a JSON list.
# See service-catalog.example.json for the shape. Unset: the resource says none is configured.
# LEXOFFICE_SERVICE_CATALOG=[{"name":"Example Workshop","unit":"Pauschal","net_price":500,"currency":"EUR"}]
